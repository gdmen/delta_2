# Delta — environment variables.
# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------------

# Postgres connection string. Local dev: point at a local Postgres
# (Postgres.app or Docker). Production: AWS RDS.
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://delta@localhost:5432/delta_dev

# ---------------------------------------------------------------------------
# Public site origin (for the data-source setup pages that show users
# the URL to point their iOS Shortcut / Strava app at). Inlined into
# the client bundle at build time, so must be NEXT_PUBLIC_*. Defaults
# to http://localhost:3001 if unset.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_ORIGIN=https://delta.example.com

# ---------------------------------------------------------------------------
# Auth & ingest (REQUIRED)
# ---------------------------------------------------------------------------

# HTTP Basic Auth gate at the proxy layer. Any password works for dev.
SITE_PASSWORD=changeme

# Bearer token for the iOS Shortcut that POSTs Apple Health data.
# Generate with: openssl rand -hex 32
# (Multi-user PR will move this into a per-user `ingest_configs` row.)
INGEST_API_KEY=changeme-32-hex-bytes

# ---------------------------------------------------------------------------
# LLM (REQUIRED for /focuses suggestions)
# ---------------------------------------------------------------------------

CLAUDE_API_KEY=sk-ant-api03-...

# ---------------------------------------------------------------------------
# Strava OAuth (optional; needed for Strava ingest)
# ---------------------------------------------------------------------------

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
