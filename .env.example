# Delta — environment variables.
# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------------

# Postgres connection string. Local dev: point at a local Postgres.
# Production: localhost socket-or-TCP on the same EC2 box (see README).
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://delta@localhost:5432/delta_dev

# ---------------------------------------------------------------------------
# Auth.js (REQUIRED)
# ---------------------------------------------------------------------------

# Signs JWTs. Generate with: openssl rand -hex 32
# Rotating this logs every user out (every JWT becomes unverifiable).
AUTH_SECRET=changeme-32-hex-bytes

# Encrypts at-rest secrets in ingest_configs (HAE bearer tokens, Strava
# OAuth tokens). Generate with: openssl rand -hex 32
# DO NOT rotate without a re-encrypt pass — existing rows will fail to
# decrypt and surface as "not connected." Set once, store somewhere
# durable (password manager).
OAUTH_ENCRYPTION_KEY=changeme-32-hex-bytes

# Comma-separated allow-list of public hostnames the app is reachable
# at. Used to gate the OAuth redirect-URI construction (Strava) against
# X-Forwarded-Host spoofing. REQUIRED in production; dev tolerates
# localhost without this set.
ALLOWED_PUBLIC_HOSTS=delta.example.com

# ---------------------------------------------------------------------------
# Public site origin
# ---------------------------------------------------------------------------

# Where users reach the app. Inlined into the client bundle at build
# time, so must be NEXT_PUBLIC_*. Defaults to http://localhost:3001 if
# unset. Used by /data-sources/* setup pages to show the user the URL
# to point their iOS Shortcut / Strava app at.
NEXT_PUBLIC_SITE_ORIGIN=https://delta.example.com

# ---------------------------------------------------------------------------
# LLM (REQUIRED for the AI coach)
# ---------------------------------------------------------------------------

CLAUDE_API_KEY=sk-ant-api03-...

# ---------------------------------------------------------------------------
# Google OAuth (OPTIONAL — enables the "Continue with Google" button)
# ---------------------------------------------------------------------------

# Set up at https://console.cloud.google.com/apis/credentials.
# Redirect URI: https://<your-host>/api/auth/callback/google
# Note: brand-new Google accounts CANNOT sign up today — the signIn
# callback in src/lib/auth/config.ts only allows Google sign-in for
# users that already have an accounts-table linkage (HIGH-3 hardening).
# The full invite-gated Google signup flow is a follow-up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Strava OAuth (OPTIONAL — enables Strava activity sync)
# ---------------------------------------------------------------------------

# Register the app at https://www.strava.com/settings/api with the
# Authorization Callback Domain set to your ALLOWED_PUBLIC_HOSTS host.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Legacy (OPTIONAL — pre-multi-user)
# ---------------------------------------------------------------------------

# HTTP Basic Auth gate at the proxy layer, only useful for staging
# environments that want to wrap the WHOLE app behind a single password
# instead of using Auth.js. Auth.js is the recommended path; leave this
# blank for normal use.
SITE_PASSWORD=

# Pre-multi-user single ingest bearer token. Replaced by per-user keys
# in ingest_configs (regenerate from /preferences/account).
# admin-bootstrap-owner.ts reads this if set, to import the legacy key
# into the owner's HAE row on first run; remove from .env.local after
# bootstrap completes.
INGEST_API_KEY=

# Argon2id at OWASP-2024 params takes ~150ms per verify and allocates
# 19 MiB. Tests set this to skip that work. Refused under
# NODE_ENV=production (src/lib/auth/password.ts) so a forgotten env-var
# leak doesn't weaken prod hashing. Leave unset.
LOW_MEMORY_ARGON_FOR_TESTS=
